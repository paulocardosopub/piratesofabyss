{
  "name": "pirates-of-the-abyss",
  "version": "1.0.0",
  "description": "Idle RPG naval em portugues para web e desktop.",
  "author": "paulocardosopub",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev:desktop": "npm run build:web && npm run build:icons && electron .",
    "build:web": "node scripts/build-web.js && node scripts/optimize-assets.js dist-web/assets",
    "optimize:assets": "node scripts/optimize-assets.js assets",
    "build:icons": "node scripts/build-icons.js",
    "build:desktop": "npm run build:web && npm run build:icons && electron-builder --dir",
    "dist": "npm run package:windows",
    "package:windows": "npm run build:web && npm run build:icons && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.paulocardosopub.piratesofabyss",
    "productName": "Pirates of the Abyss",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "dist-web/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pirates of the Abyss",
      "uninstallDisplayName": "Pirates of the Abyss"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.2"
  }
}
